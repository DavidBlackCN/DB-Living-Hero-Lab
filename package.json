{
  "name": "black-sister-living-hero-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets:generate": "node scripts/generate-scene-assets.mjs",
    "assets:normal": "python scripts/generate-registered-normal.py",
    "assets:correction": "python scripts/generate-registered-normal.py --correction-only",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/timeline.test.mjs",
    "test:visual": "playwright test",
    "test:perf": "playwright test tests/visual/performance.spec.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
